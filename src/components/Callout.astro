---
/**
 * A note set apart from the text, for MDX content.
 * The four types differ by label and border, not by colour alone,
 * so they stay clear in the one-ink palette and in both themes.
 */
interface Props {
  type?: 'info' | 'tip' | 'warning' | 'note';
  title?: string;
}

const { type = 'info', title } = Astro.props;
const labels = { info: 'Good to know', tip: 'Tip', warning: 'Warning', note: 'Note' };
---

<aside class={`callout callout-${type}`} aria-label={title ?? labels[type]}>
  <p class="callout-label">{title ?? labels[type]}</p>
  <div class="callout-body">
    <slot />
  </div>
</aside>
