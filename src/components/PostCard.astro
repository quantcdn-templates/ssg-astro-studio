---
interface Props {
  title: string;
  description: string;
  date: Date;
  slug: string;
  tags?: string[];
  category?: string;
}

const { title, description, date, slug, tags = [], category } = Astro.props;
const formattedDate = date.toLocaleDateString('en-AU', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const categoryColors: Record<string, string> = {
  tutorial: 'bg-blue-100 dark:bg-blue-900 text-blue-700 dark:text-blue-300',
  news: 'bg-purple-100 dark:bg-purple-900 text-purple-700 dark:text-purple-300',
  guide: 'bg-green-100 dark:bg-green-900 text-green-700 dark:text-green-300',
  update: 'bg-amber-100 dark:bg-amber-900 text-amber-700 dark:text-amber-300',
};
---

<article class="group">
  <a href={`/blog/${slug}`} class="block">
    <div class="flex items-center gap-3">
      <time class="text-sm text-gray-500 dark:text-gray-500" datetime={date.toISOString()}>
        {formattedDate}
      </time>
      {category && (
        <span class={`text-xs font-medium px-2 py-0.5 rounded-full ${categoryColors[category] || 'bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400'}`}>
          {category}
        </span>
      )}
    </div>
    <h2 class="mt-1 text-xl font-semibold group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors">
      {title}
    </h2>
    <p class="mt-2 text-gray-600 dark:text-gray-400 leading-relaxed">
      {description}
    </p>
  </a>
  {tags.length > 0 && (
    <div class="mt-3 flex flex-wrap gap-2">
      {tags.map((tag) => (
        <span class="text-xs px-2 py-0.5 rounded-full bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400">
          {tag}
        </span>
      ))}
    </div>
  )}
</article>
