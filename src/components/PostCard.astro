---
/**
 * One story in a list: picture, category, title, standfirst and byline.
 * The blog indexes and the 404 page use it.
 */
import { localePath } from '../lib/i18n';
import { categoryLabel, formatDate } from '../site';

interface Props {
  title: string;
  description: string;
  date: Date;
  slug: string;
  tags?: string[];
  category?: string;
  image?: string;
  author?: string;
  /** compact: no picture and a smaller title, for short lists. */
  compact?: boolean;
}

const { title, description, date: rawDate, slug, category, image, author, compact = false } = Astro.props;
const blogPath = localePath(`/blog/${slug}`, Astro.currentLocale);
const date = new Date(rawDate);
const pictured = Boolean(image) && !compact;
---

<article>
  <a href={blogPath} class={`story-link grid gap-6 md:gap-10 ${pictured ? 'md:grid-cols-12 md:items-center' : ''}`}>
    {pictured && (
      <div class="frame aspect-[3/2] md:col-span-5 lg:col-span-4">
        <img src={image} alt="" loading="lazy" />
      </div>
    )}
    <div class={pictured ? 'md:col-span-7 lg:col-span-7 lg:col-start-6' : ''}>
      {category && <p class="kicker text-lg">{categoryLabel(category)}</p>}
      <h2 class={`story-title display mt-2 leading-[1.05] ${compact ? 'text-[1.75rem]' : 'text-[2.1rem] md:text-[2.75rem]'}`}>{title}</h2>
      {!compact && <p class="mt-4 text-lg leading-relaxed muted max-w-[46ch]">{description}</p>}
      <p class="ui mt-4">
        {author && <span>By {author}, </span>}<time class="muted" datetime={date.toISOString()}>{formatDate(date)}</time>
      </p>
    </div>
  </a>
</article>
