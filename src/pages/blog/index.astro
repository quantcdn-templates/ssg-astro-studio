---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Journal from '../../components/Journal.astro';
import { isDefaultLocale } from '../../lib/i18n';
import { site } from '../../site';

const posts = (await getCollection('post'))
  .filter((post) => !post.data.draft && isDefaultLocale(post))
  .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());
---

<Layout title="The journal" description={`Every story in ${site.name}, newest first.`}>
  <Journal posts={posts} />
</Layout>
