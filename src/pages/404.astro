---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { slug, isDefaultLocale } from '../lib/i18n';

const latest = (await getCollection('post'))
  .filter((post) => !post.data.draft && isDefaultLocale(post))
  .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf())
  .slice(0, 3);
---

<Layout title="Page not found">
  <section class="wrap pt-6 md:pt-10">
    <p class="masthead" aria-hidden="true">404</p>
    <div class="mt-8 md:mt-12 grid gap-10 md:grid-cols-12">
      <div class="md:col-span-6">
        <h1 class="display text-[2.75rem] md:text-[4rem]">Page not found</h1>
        <p class="mt-5 text-xl leading-relaxed muted max-w-[36ch]">
          The address may have a typing error, or the page has moved. Go to the home page, or read one of the latest stories.
        </p>
        <p class="ui mt-8 flex flex-wrap gap-x-6 gap-y-2">
          <a href="/" class="link">Go to the home page</a>
          <a href="/blog" class="link">Read the journal</a>
        </p>
      </div>
      {latest.length > 0 && (
        <div class="md:col-span-5 md:col-start-8">
          <h2 class="kicker text-xl">Latest stories</h2>
          <ul class="mt-6 space-y-8">
            {latest.map((post) => (
              <li>
                <PostCard
                  title={post.data.title}
                  description={post.data.description}
                  date={post.data.date}
                  slug={slug(post.id)}
                  category={post.data.category}
                  compact
                />
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>
</Layout>
