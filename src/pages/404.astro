---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <div class="text-center py-20">
    <p class="text-6xl font-bold text-gray-200 dark:text-gray-800">404</p>
    <h1 class="mt-4 text-2xl font-semibold tracking-tight">Page not found</h1>
    <p class="mt-3 text-gray-600 dark:text-gray-400 max-w-md mx-auto">
      The page you are looking for does not exist or has been moved.
    </p>
    <a
      href="/"
      class="inline-block mt-8 text-sm font-medium text-accent-600 dark:text-accent-400 hover:underline"
    >
      &larr; Back to home
    </a>
  </div>
</Base>
