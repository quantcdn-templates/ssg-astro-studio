---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Home from '../../components/Home.astro';
import { entryLocale, isDefaultLocale, isLocale } from '../../lib/i18n';
import { site } from '../../site';

export async function getStaticPaths() {
  const posts = (await getCollection('post')).filter((post) => !post.data.draft && !isDefaultLocale(post));
  const locales = [...new Set(posts.map((p) => entryLocale(p.id)))];
  return locales.map((locale) => ({
    params: { lang: locale },
    props: {
      posts: posts
        .filter((p) => isLocale(p, locale))
        .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()),
    },
  }));
}

const { posts } = Astro.props;
---

<Layout title={site.name} masthead>
  <Home posts={posts} />
</Layout>
