---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { slug, entryLocale, isDefaultLocale, isLocale, localePath } from '../../lib/i18n';

export async function getStaticPaths() {
  const posts = (await getCollection('post')).filter((post) => !post.data.draft && !isDefaultLocale(post));
  const locales = [...new Set(posts.map((p) => entryLocale(p.id)))];
  return locales.map((locale) => ({
    params: { lang: locale },
    props: {
      posts: posts
        .filter((p) => isLocale(p, locale))
        .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf())
        .slice(0, 5),
    },
  }));
}

const { posts } = Astro.props;
---

<Layout title="Home">
  <section class="mb-16">
    <h1 class="text-4xl font-bold tracking-tight">
      Welcome to your site
    </h1>
    <p class="mt-4 text-lg text-gray-600 dark:text-gray-400 leading-relaxed max-w-2xl">
      A clean starting point for content-driven websites. Write in markdown, edit visually with Quant Studio, deploy to a global CDN.
    </p>
  </section>

  <section>
    <h2 class="text-sm font-medium uppercase tracking-wider text-gray-500 dark:text-gray-500 mb-8">
      Recent posts
    </h2>
    <div class="space-y-10">
      {posts.map((post) => (
        <PostCard
          title={post.data.title}
          description={post.data.description}
          date={post.data.date}
          slug={slug(post.id)}
          tags={post.data.tags}
          category={post.data.category}
        />
      ))}
    </div>
    <div class="mt-10">
      <a href={localePath('/blog', Astro.currentLocale)} class="text-sm font-medium text-accent-600 dark:text-accent-400 hover:underline">
        All posts &rarr;
      </a>
    </div>
  </section>
</Layout>
