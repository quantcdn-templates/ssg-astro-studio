{
  "name": "ssg-astro-studio",
  "description": "Content-driven Astro site with Quant Studio integration",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "npm run check:eslint && npm run check:prettier",
    "check:eslint": "eslint .",
    "check:prettier": "prettier --check .",
